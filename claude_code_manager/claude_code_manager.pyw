        lay.addWidget(title)

        # Подзаголовок + значок «?» с подсказкой, откуда взять точное время.
        sub_row = QHBoxLayout()
        sub_row.setSpacing(6)
        sub_row.addStretch()
        subtitle = QLabel(tr("Время следующего сброса") + "  (UTC+8)")
        subtitle.setFont(QFont("Segoe UI", 10))
        subtitle.setAlignment(Qt.AlignCenter)
