# Создаем полоску контекста
context_bar=""
if [ -n "$used_pct" ]; then
    # Округляем процент
    used_int=$(printf "%.0f" "$used_pct")

    # Создаем полоску из 20 сегментов
    filled=$((used_int / 5))
    empty=$((20 - filled))

    context_bar="["
    for ((i=0; i<filled; i++)); do
        context_bar="${context_bar}="
