        row.addWidget(left_w)
        status = QLabel(self._row_label(key))
        status.setFont(QFont("Segoe UI", 9))
        status.setStyleSheet(
            "QLabel { color: rgb(140,140,148); background: transparent; border: none; }"
            "QLabel:disabled { color: rgb(95, 95, 102); background: transparent; border: none; }")
        status.setSizePolicy(QSizePolicy.Ignored, QSizePolicy.Preferred)
        row.addWidget(status, 1)
        play = _PlayButton()
        # clicked шлёт bool — принимаем его первым, иначе затёрт k.
        play.clicked.connect(lambda _c=False, k=key: _oc_preview_sound(k, self._sounds, self._volumes))
        row.addWidget(play)
        # Кнопки — штатные StyledButton: плавный ховер и дим как везде.
        pick = StyledButton(tr("Выбрать"), compact=True)
        pick.set_hover_color(52, 211, 153)
        pick.setFixedHeight(30)
        pick.clicked.connect(lambda: self._choose(key))
        row.addWidget(pick)
        reset = StyledButton(tr("Сбросить"), compact=True)
        reset.set_hover_color(224, 90, 90)
        reset.setFixedHeight(30)
        reset.setToolTip("")
        reset.clicked.connect(lambda: self._reset_one(key))
        row.addWidget(reset)
        self._rows[key] = (status, play, pick, reset, slider, vollbl)
        self._refresh_reset(key)
        return card

    def _is_standard(self, key):
        try:
            cur = self._sounds.get(key, "")
            same = bool(cur) and os.path.normcase(os.path.abspath(cur)) == os.path.normcase(
                os.path.abspath(_oc_notify_defaults()[key]))
            return same and self._volumes.get(key, 75) == 75
        except Exception:
            return False

    def _refresh_reset(self, key):
        _status, _play, _pick, reset = self._rows[key][:4]
        try:
            on = bool(self._enabled)
        except Exception:
            on = True
        reset.setEnabled(on and not self._is_standard(key))

    def _refresh_row(self, key):
        status = self._rows[key][0]
        status.setText(self._row_label(key))
        status.setToolTip(self._sounds.get(key, ""))
        slider = self._rows[key][4]
        try:
            if slider.value() != self._volumes.get(key, 75):
                slider.blockSignals(True)
                slider.setValue(self._volumes.get(key, 75))
                slider.blockSignals(False)
        except Exception:
            pass
        self._rows[key][5].setText("%d%%" % self._volumes.get(key, 75))
        self._refresh_reset(key)

    def _arm_volume(self, key):
        """Перезапускает дебаунс-применение громкости (для стрелок/колеса)."""
        try:
            if self._vol_timer is None:
                self._vol_timer = QTimer(self)
                self._vol_timer.setSingleShot(True)
                self._vol_timer.timeout.connect(self._on_volume_debounced)
            self._vol_pending = key
            self._vol_timer.start(350)
        except Exception:
            pass

    def _on_volume_debounced(self):
        key = getattr(self, "_vol_pending", None)
        if key:
            self._on_volume(key)

    def _on_volume(self, key, now=False):
        """Применяем громкость: сохраняем, пересобираем гейн-копию,
        обновляем tui (если вкл). now=True — сразу (отпускание мыши);
        через дебаунс — для стрелок/колеса."""
        try:
            if self._vol_timer is not None and now:
                self._vol_timer.stop()
        except Exception:
            pass
        try:
            self._volumes[key] = max(0, min(100, int(self._rows[key][4].value())))
        except Exception:
            return
        self._persist()
        self._refresh_row(key)

    def _tui_sounds(self):
        """Пути для tui.json: с учётом громкости каждого звука."""
        out = {}
        for key, _label in OC_NOTIFY_KEYS:
            p = _oc_resolve_sound(key, self._sounds, self._volumes)
            if p:
                out[key] = p
        return out

    def _persist(self):
        """Пишет выбор и громкости в settings.json + применяет в tui.json (если вкл)."""
        try:
            self._settings["oc_notify_enabled"] = bool(self._enabled)
            self._settings["oc_notify_sounds"] = dict(self._sounds)
            self._settings["oc_notify_volumes"] = dict(self._volumes)
            save_settings(self._settings)
        except Exception:
            pass
        try:
            if self._enabled:
                _oc_write_notify_tui(self._tui_sounds())
            else:
                _oc_remove_notify_tui()
        except Exception:
            pass

    def _apply_enabled(self, animate=True):
        # Выкл: фрейм НЕ гасим целиком (иначе ▶ тоже умирает) — димим только
        # настройки: слайдер, выбор, сброс. Проверка звука работает всегда.
        on = bool(self._enabled)
        try:
            self.toggle.set_on(on, animate=animate)
        except Exception:
            pass
        for key in getattr(self, "_rows", {}):
            try:
                _status, _play, pick, _reset, slider, _vollbl = self._rows[key]
                slider.setEnabled(on)
                pick.setEnabled(on)
            except Exception:
                pass
            self._refresh_reset(key)
        self._repaint_all()

    def _on_toggle(self, on):
        self._enabled = bool(on)
        self._persist()
        self._apply_enabled()

    def _choose(self, key):
        start = os.path.dirname(self._sounds.get(key, "") or "")
        if not start or not os.path.isdir(start):
            start = os.path.expanduser("~")
        path, _ = QFileDialog.getOpenFileName(
            self, tr("Выбрать звук"), start, _OC_AUDIO_FILTER)
        if not path:
            return
        # Копируем в папку приложения: оригинал можно удалять — проблем не будет.
        try:
            path = _oc_import_sound(key, path)
        except Exception:
            return
        self._sounds[key] = path
        self._persist()
        self._refresh_row(key)

    def _reset_one(self, key):
        """Сброс одного звука к стандартному (и громкость 75): свой
        скопированный файл удаляется из папки приложения. Кнопка неактивна,
        если звук и так стандартный. Спрашиваем подтверждение."""
        label = dict(OC_NOTIFY_KEYS).get(key, key)
        confirm = ConfirmActionDialog(
            title=tr("Сбросить звук?"),
            message=tr("Звук вернётся к стандартному, а свой файл удалится."),
            detail=tr(label),
            confirm_text=tr("Да, сбросить"),
            icon="!",
            icon_color=(224, 90, 90),
            parent=self.window(),
        )
        if confirm.exec() != QDialog.Accepted:
            return
        try:
            cur = self._sounds.get(key, "")
            self._sounds[key] = _oc_notify_defaults()[key]
            self._volumes[key] = 75
            # Чистим свою копию, чтобы не копился мусор.
            try:
                if cur and os.path.basename(cur).startswith("oc_custom_"):
                    folder = os.path.normcase(_oc_sounds_dir() + os.sep)
                    if os.path.normcase(cur).startswith(folder) and os.path.exists(cur):
                        os.remove(cur)
            except Exception:
                pass
        except Exception:
            return
        self._persist()
        self._refresh_row(key)

    def showEvent(self, event):
        super().showEvent(event)
        self._fade_anim.start()
        # Окно неперетаскиваемое — всегда строго по центру: центр видимого
        # родителя, иначе центр экрана.
        try:
            parent_win = self.parent().window() if self.parent() else None
            if parent_win is not None and parent_win.isVisible():
                pg = parent_win.frameGeometry()
                cx, cy = pg.center().x(), pg.center().y()
            else:
                screen = QGuiApplication.primaryScreen().availableGeometry()
                cx, cy = screen.center().x(), screen.center().y()
            self.move(cx - self.width() // 2, cy - self.height() // 2)
        except Exception:
            pass
        # Frameless + translucent + скролл: без принудительной перерисовки
        # окно открывается пустым, контент проявляется только от ховера.
        self._repaint_all()
        QTimer.singleShot(0, self._repaint_all)
        QTimer.singleShot(150, self._repaint_all)
        # Синхронизация при открытии: если вкл — tui.json приводим к выбору.
        if self._enabled:
            try:
                _oc_write_notify_tui(self._tui_sounds())
            except Exception:
                pass

    def _repaint_all(self):
        """Полная перерисовка (как у ключей): контейнер, список, карточки —
        иначе «призраки» и наложения на frameless-окне."""
        try:
            self._container.update()
            self.list_frame.update()
            self.update()
            self.repaint()
            try:
                self.list_frame.repaint()
            except Exception:
                pass
            for key in getattr(self, "_rows", {}):
                try:
                    self._rows[key][0].parent().update()
                except Exception:
                    pass
        except Exception:
            pass

    def accept(self):
        fade = QPropertyAnimation(self._opacity_effect, b"opacity", self)
        fade.setDuration(200)
        fade.setStartValue(self._opacity_effect.opacity())
        fade.setEndValue(0.0)
        fade.setEasingCurve(QEasingCurve.OutCubic)
        fade.finished.connect(lambda: super(OcNotifyDialog, self).accept())
        fade.start()
        self._fade_out = fade

    def reject(self):
        # Всё уже применено живьём — Escape ничего не теряет.
        self.accept()

    # Окно неперетаскиваемое (крестик после drag гас из-за implicit grab),
    # поэтому всегда центрируется при показе: ручных хендлеров мыши нет.


class OcModelDialog(QDialog):
    """Информационное окно для вкладки Custom URL (opencode).

    Показывает, какие модели доступны:
    - секция «Для вашего провайдера доступны модели» — модели эндпоинта
      ({base_url}/models), названия подсвечены цветом;
    - секция «UNLIMIT MODELS» — бесплатные модели opencode;
    - внизу блок-инструкция: как сменить модель (через /model в opencode) и
      что список обновляется автоматически при каждом открытии.

    Чисто информационное: выбора моделей и effort'а нет. Кастомный тёмный
    фон, контент в прокручиваемой области (при большом списке окно
    расширяется и скроллится, а не убегает за экран)."""

    MAX_W = 680
    MAX_H = 660
    MIN_W = 380

    def __init__(self, endpoint_models, free_models, reasoning_map, provider_name="", parent=None):
        super().__init__(parent)
        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Dialog | Qt.NoDropShadowWindowHint)
        self.setAttribute(Qt.WA_TranslucentBackground)
        self.setAttribute(Qt.WA_DeleteOnClose, True)
        self.setModal(True)
        self._endpoint = list(endpoint_models or [])
        self._free = [m for m in (free_models or []) if m not in self._endpoint]
        self._provider_name = provider_name

        outer = QVBoxLayout(self)
        outer.setContentsMargins(14, 14, 14, 14)

        container = DottedFrame()
        container.setObjectName("ocModelDialogContainer")
        container.setStyleSheet("""
            QFrame#ocModelDialogContainer {
                background-color: rgb(20, 20, 25);
                border: 2px solid rgb(60, 60, 65);
                border-radius: 16px;
            }
        """)
        outer.addWidget(container)

        shadow = QGraphicsDropShadowEffect(container)
        shadow.setColor(QColor(0, 0, 0, 200))
        shadow.setBlurRadius(40)
        shadow.setOffset(0, 6)
        container.setGraphicsEffect(shadow)

        inner = QVBoxLayout(container)
        inner.setContentsMargins(18, 12, 18, 16)
        inner.setSpacing(10)

        head = QHBoxLayout()
        head.setContentsMargins(0, 0, 0, 0)
