def _oc_builtin_sounds():
    """Вшитые звуки: оригинальные wav из приложения. При первом использовании
    пишутся в папку приложения — дальше используются оттуда."""
    out = {}
    try:
        os.makedirs(_oc_sounds_dir(), exist_ok=True)
    except Exception:
        pass
    for name in ("notify", "proximity", "error"):
        gen = os.path.join(_oc_sounds_dir(), "oc_%s.wav" % name)
        if not os.path.exists(gen):
            try:
                import base64
                raw = base64.b64decode(_OC_EMBEDDED_WAVS.get(name, ""))
                if raw[:4] == b"RIFF":
                    with open(gen, "wb") as f:
                        f.write(raw)
            except Exception:
                pass
        if os.path.exists(gen):
            out[name] = gen
    return out


def _oc_notify_defaults():
    """Дефолтные звуки: всегда вшитые (свои wav приложения).
    Никогда не бросает исключение и всегда возвращает все 4 ключа
    (пустая строка = нет файла, везде обрабатывается безопасно)."""
    try:
        b = _oc_builtin_sounds()
    except Exception:
        b = {}
    return {
        "done": b.get("notify", ""),
        "question": b.get("proximity", ""),
        "permission": b.get("proximity", ""),
        "error": b.get("error", ""),
    }


def _oc_tui_path():
    """Путь к tui.json ТЕКУЩЕГО пользователя (другие люди — свой путь)."""
    return os.path.join(os.path.expanduser("~"), ".config", "opencode", "tui.json")


def _oc_load_tui():
    try:
        with open(_oc_tui_path(), "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _oc_save_tui(data):
    try:
        os.makedirs(os.path.dirname(_oc_tui_path()), exist_ok=True)
        with open(_oc_tui_path(), "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        return True
    except Exception:
        return False


def _oc_write_notify_tui(sounds):
    """Включает звуки: пишет attention-блок в tui.json, остальное (схема,
    чужие секции, громкость) не трогает."""
    data = _oc_load_tui()
    att = data.get("attention")
    if not isinstance(att, dict):
        att = {}
    prev_vol = att.get("volume", 0.4)
    try:
        prev_vol = float(prev_vol)
    except Exception:
        prev_vol = 0.4
    att["enabled"] = True
    att["notifications"] = True
    att["sound"] = True
    att["volume"] = prev_vol
    snd = att.get("sounds")
    if not isinstance(snd, dict):
        snd = {}
    for key, _label in OC_NOTIFY_KEYS:
        if sounds.get(key):
            snd[key] = sounds[key]
    # default/subagent_done в диалоге не показываем, но в tui.json держим:
    # opencode использует их как фолбэк (default — для всех событий без
    # своего звука). Без них терминал играет что-то своё, а не настроенное.
    # Маппим на звук «Готово» — как было в исходном конфиге пользователя.
    done_path = sounds.get("done", "") or ""
    if done_path:
        snd.setdefault("default", done_path)
        snd.setdefault("subagent_done", done_path)
    att["sounds"] = snd
    data["attention"] = att
    return _oc_save_tui(data)


def _oc_remove_notify_tui():
    """Выключает звуки: удаляет attention-блок из tui.json. Если кроме схемы
    ничего не осталось — удаляет файл целиком."""
    try:
        path = _oc_tui_path()
        if not os.path.exists(path):
            return True
        data = _oc_load_tui()
        if isinstance(data, dict) and "attention" in data:
            del data["attention"]
        rest = [k for k in data.keys() if k != "$schema"] if isinstance(data, dict) else []
        if not rest:
            try:
                os.remove(path)
            except Exception:
                pass
            return True
        return _oc_save_tui(data)
    except Exception:
        return False


_OC_AUDIO_FILTER = "WAV (*.wav);;All files (*.*)"
_OC_PLAYERS = []


def _oc_play_sound(path):
    """Предпросмотр звука WAV (асинхронно, окно не блокируется)."""
    try:
        if not path or not os.path.exists(path):
            return
        import winsound
        winsound.PlaySound(path, winsound.SND_FILENAME | winsound.SND_ASYNC
                           | winsound.SND_NODEFAULT)
    except Exception:
        pass


def _oc_preview_sound(key, sounds, volumes):
    """Проверка звука — ровно та громкость, что услышит терминал:
    громкость строки × глобальная громкость tui."""
    try:
        src = (sounds or {}).get(key, "") or ""
    except Exception:
        src = ""
    if not src or not os.path.exists(src):
        return
    try:
        row_pct = max(0, min(100, int((volumes or {}).get(key, 75))))
    except Exception:
        row_pct = 100
    try:
        gvol = float((_oc_load_tui().get("attention") or {}).get("volume", 0.4))
    except Exception:
        gvol = 0.4
    pct = int(round(row_pct * max(0.0, min(1.0, gvol))))
    if pct >= 100:
        _oc_play_sound(src)
        return
    tmp = os.path.join(tempfile.gettempdir(), "oc_preview_%s.wav" % key)
    try:
        if _oc_render_gain(src, tmp, pct):
            _oc_play_sound(tmp)
        else:
            _oc_play_sound(src)
    except Exception:
        pass


class _PlayButton(QPushButton):
    """Векторная кнопка прослушки: треугольник рисуется QPainter
    (как иконки чейнджлога) — чёткий на любом масштабе. Наведение —
    плавное разгорание (таймер 16мс, как у остальных кнопок)."""

    def __init__(self, parent=None):
        super().__init__("", parent)
        self.setFixedSize(30, 30)
        self.setCursor(Qt.PointingHandCursor)
        self._hp = 0.0
        self._hp_target = 0.0
        self._timer = QTimer(self)
        self._timer.timeout.connect(self._tick)
        self._timer.start(16)

    def enterEvent(self, event):
        self._hp_target = 1.0
        super().enterEvent(event)

    def leaveEvent(self, event):
        self._hp_target = 0.0
        super().leaveEvent(event)

    def _tick(self):
        d = self._hp_target - self._hp
        if abs(d) > 0.004:
            self._hp += d * 0.18
            self.update()
        elif self._hp != self._hp_target:
            self._hp = self._hp_target
            self.update()

    def paintEvent(self, event):
        # При наведении загорается ТОЛЬКО рамка — треугольник статичен.
        p = QPainter(self)
        p.setRenderHint(QPainter.Antialiasing)
        hp = self._hp if self.isEnabled() else 0.0
        dis = not self.isEnabled()
        if dis:
            bc = QColor(90, 90, 96)
        else:
            bc = QColor(52, 211, 153)
        p.setPen(QPen(QColor(60, 60, 65) if dis else QColor(52, 211, 153, 102 + int(98 * hp)), 2))
        p.setBrush(Qt.NoBrush)
        p.drawRoundedRect(self.rect().adjusted(1, 1, -1, -1), 8, 8)
        tri = QPainterPath()
        tri.moveTo(12.0, 9.0)
        tri.lineTo(12.0, 21.0)
        tri.lineTo(20.0, 15.0)
        tri.closeSubpath()
        p.setPen(Qt.NoPen)
        p.fillPath(tri, bc)
        p.end()


def _oc_import_sound(key, src_path):
    """Копирует выбранный звук в папку приложения (уникальное имя) и
    возвращает путь копии. Оригинал можно удалять/перемещать — проблем не будет."""
    import shutil
    dest_dir = _oc_sounds_dir()
    os.makedirs(dest_dir, exist_ok=True)
    stem, ext = os.path.splitext(os.path.basename(src_path) or "sound")
    stem = re.sub(r"[^A-Za-z0-9а-яА-Я_\\-]", "_", stem[:24] or "sound")
    if not ext:
        ext = ".wav"
    dest = os.path.join(dest_dir, "oc_custom_%s_%s%s" % (key, stem, ext))
    i = 2
    while os.path.exists(dest):
        dest = os.path.join(dest_dir, "oc_custom_%s_%s_%d%s" % (key, stem, i, ext))
        i += 1
        if i > 50:
            break
    shutil.copy2(src_path, dest)
    return dest


def _oc_decode_pcm16(src_path, timeout_ms=15000):
    """Декодирует любой аудиоформат в PCM16 mono через системные кодеки
    (mp3/m4a/wma/ogg...). Возвращает (rate, [samples]) или None.
    Формат буферов читаем по факту — бэкенд может отдать свой."""
    import struct as _st
    try:
        from PySide6.QtMultimedia import QAudioDecoder, QAudioFormat
        from PySide6.QtCore import QUrl, QEventLoop, QTimer
        fmt = QAudioFormat()
        fmt.setSampleRate(44100)
        fmt.setChannelCount(1)
        fmt.setSampleFormat(QAudioFormat.Int16)
        dec = QAudioDecoder()
        dec.setAudioFormat(fmt)
        dec.setSource(QUrl.fromLocalFile(src_path))
        raws = []
        loop = QEventLoop()
        def _grab():
            try:
                buf = dec.read()
                bf = buf.format()
                data = bytes(memoryview(buf.constData()))[:buf.byteCount()]
                raws.append((bf, data))
            except Exception:
                pass
        dec.bufferReady.connect(_grab)
        dec.finished.connect(loop.quit)
        dec.errorOccurred.connect(lambda *a: None)
        QTimer.singleShot(timeout_ms, loop.quit)
        dec.start()
        loop.exec()
        try:
            dec.stop()
        except Exception:
            pass
        if not raws:
            return None
        out = []
        rate = 44100
        for bf, data in raws:
            try:
                ch = max(1, int(bf.channelCount()))
                rate = int(bf.sampleRate()) or 44100
                st = bf.sampleFormat()
            except Exception:
                continue
            try:
                if st == QAudioFormat.UInt8:
                    n = len(data)
                    vals = [(b - 128) * 256 for b in data[:n]]
                elif st == QAudioFormat.Int32:
                    n = len(data) // 4
                    vals = [v >> 16 for v in _st.unpack("<%di" % n, data[:n * 4])]
                elif st == QAudioFormat.Float:
                    n = len(data) // 4
                    vals = [max(-32768, min(32767, int(v * 32767)))
                            for v in _st.unpack("<%df" % n, data[:n * 4])]
                else:
                    n = len(data) // 2
                    vals = list(_st.unpack("<%dh" % n, data[:n * 2]))
            except Exception:
                continue
            if ch > 1 and vals:
                vals = [sum(vals[i:i + ch]) // ch for i in range(0, len(vals), ch)]
            out.extend(vals)
        if not out:
            return None
        return rate, out
    except Exception:
        return None


def _oc_write_pcm16(dest_path, rate, samples):
    import wave
    import struct
    with wave.open(dest_path, "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(int(rate))
        w.writeframes(struct.pack("<%dh" % len(samples), *[max(-32768, min(32767, int(v))) for v in samples]))


def _oc_render_gain(src_path, dest_path, pct):
    """Гейн-копия wav (16-бит PCM): шкала ×2 — 50% это исходная громкость,
    100% в два раза громче (с клиппингом в int16). Не-WAV декодируется
    через системные кодеки, копия всегда WAV. Возвращает True, если
    получилось; иначе False (берём файл как есть)."""
    import wave
    import struct
    try:
        pct = max(0, min(100, int(pct)))
    except Exception:
        return False
    k = pct / 50.0
    try:
        with wave.open(src_path, "rb") as w:
            if w.getsampwidth() != 2:
                raise ValueError("not s16")
            params = (w.getnchannels(), w.getsampwidth(), w.getframerate(),
                      w.getnframes(), w.getcomptype(), w.getcompname())
            frames = w.readframes(w.getnframes())
        n = len(frames) // 2
        vals = struct.unpack("<%dh" % n, frames[:n * 2])
        out = struct.pack("<%dh" % n, *[max(-32768, min(32767, int(v * k))) for v in vals])
        with wave.open(dest_path, "wb") as w:
            w.setnchannels(params[0])
            w.setsampwidth(params[1])
            w.setframerate(params[2])
            w.writeframes(out)
        return True
    except Exception:
        pass
    try:
        decoded = _oc_decode_pcm16(src_path)
        if not decoded:
            return False
        rate, vals = decoded
        out = [max(-32768, min(32767, int(v * k))) for v in vals]
        _oc_write_pcm16(dest_path, rate, out)
        return True
    except Exception:
        return False


def _oc_gain_dir():
    """Папка гейн-копий (временная, не в приложении): пересоздаются сами,
    если система её почистила."""
    return os.path.join(tempfile.gettempdir(), "ccm_oc_sounds")


def _oc_cleanup_gain(key, keep=""):
    """Стирает устаревшие гейн-копии ключа, кроме keep."""
    try:
        folder = _oc_gain_dir()
        prefix = "oc_%s_v" % key
        for fn in os.listdir(folder):
            if fn.startswith(prefix) and fn.endswith(".wav"):
                full = os.path.join(folder, fn)
                if full != keep and os.path.exists(full):
                    try:
                        os.remove(full)
                    except Exception:
                        pass
    except Exception:
        pass


def _oc_resolve_sound(key, sounds, volumes):
    """Путь для tui.json: при громкости 100 — сам файл, иначе гейн-копия
    во временной папке (в приложении файлы не плодятся)."""
    try:
        src = sounds.get(key, "") or ""
    except Exception:
        src = ""
    try:
        pct = int((volumes or {}).get(key, 75))
    except Exception:
        pct = 100
    pct = max(0, min(100, pct))
    if not src or not os.path.exists(src) or pct == 50:
        if src and os.path.exists(src):
            _oc_cleanup_gain(key)
        return src
    try:
        os.makedirs(_oc_gain_dir(), exist_ok=True)
    except Exception:
        pass
    dest = os.path.join(_oc_gain_dir(), "oc_%s_v%d.wav" % (key, pct))
    if not os.path.exists(dest):
        if not _oc_render_gain(src, dest, pct):
            _oc_cleanup_gain(key)
            return src
    _oc_cleanup_gain(key, keep=dest)
    return dest


